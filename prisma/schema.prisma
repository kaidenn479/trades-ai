generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Technician {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  phone         String?
  bio           String?
  timezone      String   @default("America/New_York")
  tradeType     String   @default("General")
  licenseNumber String?
  serviceArea   String?
  emergencyService Boolean @default(false)

  smtpHost      String?
  smtpPort      Int?
  smtpUser      String?
  smtpPass      String?

  password      String?
  aiPersonality String?

  weeklyHours      String?
  resetToken       String?
  resetTokenExpiry String?
  plan                 String   @default("starter")
  brandColor           String   @default("#f97316")
  messageCount         Int      @default(0)
  messageResetAt       String?
  stripePublishableKey String?
  stripeSecretKey      String?
  status               String   @default("active")
  deletedAt            String?

  services      Service[]
  faqs          FAQ[]
  clients       Client[]
  appointments  Appointment[]
  blockedSlots  BlockedSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id             String  @id @default(cuid())
  technicianId   String
  technician     Technician @relation(fields: [technicianId], references: [id])
  name           String
  category       String  @default("General")
  description    String?
  basePrice      Float?
  priceType      String  @default("flat")
  estimatedHours Float?
  status         String  @default("available")
  available247   Boolean @default(false)
  createdAt      DateTime @default(now())
}

model FAQ {
  id           String @id @default(cuid())
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id])
  question     String
  answer       String
}

model Client {
  id           String   @id @default(cuid())
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id])
  name         String?
  email        String?
  phone        String?
  notes        String?
  messages     Message[]
  appointments Appointment[]
  createdAt    DateTime @default(now())
}

model Message {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  direction   String
  channel     String
  content     String
  subject     String?
  aiGenerated Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model BlockedSlot {
  id           String   @id @default(cuid())
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id])
  date         String
  startTime    String?
  endTime      String?
  reason       String?
  allDay       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Appointment {
  id             String   @id @default(cuid())
  technicianId   String
  technician     Technician @relation(fields: [technicianId], references: [id])
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])
  title          String
  startTime      DateTime
  endTime        DateTime
  location       String?
  notes          String?
  status         String   @default("confirmed")
  createdAt      DateTime @default(now())
}
